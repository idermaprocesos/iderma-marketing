<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BitacoraGrabacion.Pages.ReportesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:BitacoraGrabacion.Models"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Spacing="4">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Reportes" />
            <TextBlock
                Style="{StaticResource PageSubtitleStyle}"
                Text="Elige el periodo, revisa el total y exporta el informe o una grabación." />
        </StackPanel>

        <Border
            Grid.Row="1"
            MaxWidth="{StaticResource ContentMaxWidth}"
            HorizontalAlignment="Stretch"
            Style="{StaticResource SectionCardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ComboBox
                    x:Name="PeriodoCombo"
                    HorizontalAlignment="Stretch"
                    Header="Periodo"
                    SelectedIndex="0"
                    SelectionChanged="Filtro_Changed"
                    VerticalAlignment="Bottom">
                    <ComboBoxItem Content="Semana" Tag="semana" />
                    <ComboBoxItem Content="Quincena" Tag="quincena" />
                    <ComboBoxItem Content="3 semanas" Tag="tres" />
                    <ComboBoxItem Content="Mes" Tag="mes" />
                </ComboBox>

                <CalendarDatePicker
                    x:Name="ReferenciaPicker"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    DateFormat="{}{day.integer} {month.full} {year.full}"
                    Header="Fecha de referencia"
                    PlaceholderText="Elige una fecha"
                    DateChanged="ReferenciaPicker_DateChanged"
                    VerticalAlignment="Bottom" />

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="2">
                    <TextBlock
                        x:Name="TotalBlock"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="0" />
                    <TextBlock
                        x:Name="RangoBlock"
                        Style="{StaticResource PageSubtitleStyle}"
                        Text=""
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Bottom"
                    Click="Exportar_Click"
                    Content="Exportar reportes"
                    Style="{StaticResource AccentButtonStyle}" />

                <InfoBar
                    x:Name="AvisoBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="4"
                    IsClosable="True"
                    IsOpen="False" />
            </Grid>
        </Border>

        <Grid
            Grid.Row="2"
            MaxWidth="{StaticResource ContentMaxWidth}"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Grabaciones" />
                    <ListView
                        x:Name="GrabacionesList"
                        Grid.Row="1"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="GrabacionesList_ItemClick"
                        ItemContainerStyle="{StaticResource ListaTarjetaItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RegistroGrabacion">
                                <Grid Padding="0,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Titulo}" TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind EstadoTexto}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind FechaLimiteTexto}"
                                            Visibility="{x:Bind LimiteNormalVisibility}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Text="{x:Bind FechaLimiteTexto}"
                                            Visibility="{x:Bind LimiteVencidaVisibility}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind FechaTexto}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind PersonasTexto}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="ExportarIndividual_Click"
                                        Tag="{x:Bind IdTexto}"
                                        ToolTipService.ToolTip="Exportar esta grabación">
                                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="GrabacionesVacio"
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No hay grabaciones en este periodo."
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SectionCardStyle}" Padding="16">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Por cargo" />
                    <ListView
                        x:Name="CargosList"
                        Grid.Row="1"
                        Padding="0"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource ListaTarjetaItemStyle}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CargoReporte">
                                <Grid Padding="0,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Cargo}" TextWrapping="Wrap" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Personas}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind GrabacionesTexto}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="CargosVacio"
                        Grid.Row="1"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No hay cargos en este periodo."
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
